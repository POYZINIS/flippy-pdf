{
  "name": "pdfthing",
  "version": "1.0.0",
  "description": "PDFthing: a minimal PDF reader for Windows and the web, with curved page turns and a scrolling layout.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./style.css": "./src/flipbook.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "start": "vite",
    "build": "vite build",
    "icons": "node scripts/icons.mjs",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "test": "playwright test",
    "desktop": "npm run build && node scripts/desktop.mjs",
    "dist:win": "install-electron && npm run build && electron-builder --win --x64",
    "package:dev": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-dev.ps1",
    "test:desktop": "playwright test --config playwright.desktop.config.js",
    "profile:memory": "npm run build && node scripts/memory-profile.mjs",
    "profile:pages": "npm run build && node scripts/page-speed-browser.mjs"
  },
  "keywords": [
    "pdf",
    "flipbook",
    "issuu",
    "magazine",
    "viewer",
    "pdfjs",
    "page-flip",
    "pdf-viewer"
  ],
  "author": "mwisam <mohamed.wisam87@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wisam87/flippy-pdf.git"
  },
  "bugs": {
    "url": "https://github.com/wisam87/flippy-pdf/issues"
  },
  "homepage": "https://github.com/wisam87/flippy-pdf#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.9",
    "@jungherz-de/glasskit": "^1.11.0",
    "animejs": "^4.5.0",
    "neumorui": "^1.0.0",
    "pdfjs-dist": "^4.7.76",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.4.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.0"
  }
}
